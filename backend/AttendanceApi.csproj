<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FaceNativeRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FaceNativeRuntime>
    <FaceNativeRuntime Condition="'$(FaceNativeRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</FaceNativeRuntime>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261018" />
    <PackageReference Include="OpenCvSharp5.runtime.osx.arm64" Version="5.0.0.20261018" Condition="'$(FaceNativeRuntime)' == 'osx-arm64'" />
    <PackageReference Include="OpenCvSharp5.runtime.osx.x64" Version="5.0.0.20261018" Condition="'$(FaceNativeRuntime)' == 'osx-x64'" />
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261018" Condition="'$(FaceNativeRuntime)' == 'win-x64'" />
    <PackageReference Include="OpenCvSharp5.runtime.win-arm64" Version="5.0.0.20261018" Condition="'$(FaceNativeRuntime)' == 'win-arm64'" />
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-x64.headless" Version="5.0.0.20261018" Condition="'$(FaceNativeRuntime)' == 'linux-x64'" />
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-arm64.headless" Version="5.0.0.20261018" Condition="'$(FaceNativeRuntime)' == 'linux-arm64'" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Models/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
